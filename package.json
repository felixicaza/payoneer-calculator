{
  "name": "payoneer-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Calcula de manera FÁCIL, RÁPIDA Y SEGURA, todas las COMISIONES DE PAYONEER Y DEL BANCO aplicadas al momento de realizar un retiro de un CAJERO ATM en Nicaragua.",
  "homepage": "https://payoneer-calculator.web.app/",
  "bugs": {
    "url": "https://github.com/felixicaza/payoneer-calculator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixicaza/payoneer-calculator.git"
  },
  "license": "MIT",
  "author": "Felix Icaza <fx.joliett17@gmail.com>",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously && eslint . --cache --fix",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "start": "astro dev",
    "typecheck": "oxlint --type-aware --type-check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "pnpm lint:fix"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/preact": "6.0.2",
    "@playform/compress": "0.2.3",
    "@playform/inline": "0.1.4",
    "@unocss/reset": "66.7.5",
    "@vite-pwa/astro": "1.2.0",
    "@xtreat/astro-iconify": "1.2.7",
    "astro": "7.1.6",
    "astro-capo": "0.0.1",
    "astro-compressor": "1.3.0",
    "astro-seo-schema": "7.0.0",
    "astro-sitemap": "1.0.0",
    "firebase": "12.17.0",
    "lightningcss": "1.33.0",
    "preact": "10.29.8",
    "schema-dts": "1.1.5",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.1",
    "@felixicaza/eslint-config": "0.1.4",
    "@felixicaza/oxlint-config": "0.1.5",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks-extra": "2.13.0",
    "eslint-plugin-react-refresh": "0.5.3",
    "jiti": "2.7.0",
    "nano-staged": "1.0.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "simple-git-hooks": "2.13.1"
  }
}
