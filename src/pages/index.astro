---
import Layout from '@layouts/Layout.astro'
import Icon from '@xtreat/astro-iconify'
import Calculator from '@components/Calculator.tsx'
import Author from '@components/Author.astro'

import { DESCRIPTION } from '@data/constants'

const options = {
  title: 'Calculadora de Comisiones de Payoneer en Nicaragua',
  description: DESCRIPTION
}
---

<Layout options={options}>
  <main>
    <section>
      <h1>Calculadora Payoneer Nicaragua</h1>
      <Calculator client:load />
    </section>

    <footer>
      <a href="/como-funciona">
        <Icon height={20} icon="material-symbols:help-rounded" width={20} />
        ¿Cómo funciona?
      </a>

      <Author />
    </footer>
  </main>
</Layout>

<style>
  main {
    display: grid;
    height: 100svh;
    grid-template-rows: 1fr;
    padding: 32px 16px;
    text-align: center;

    section {
      align-self: center;

      h1 {
        font-size: 48px;
        line-height: 1;
        font-weight: bold;
        margin-bottom: 32px;
      }
    }

    footer a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      font-weight: 600;

      &:active {
        text-decoration: underline;
      }

      @media (any-hover: hover) {
        &:hover {
          text-decoration: underline;
        }
      }

      svg {
        translate: 0 1px;
      }
    }
  }
</style>
