---
import type { PWAAssetHeadLink } from 'virtual:pwa-assets/head'

import { Head } from '@felixicaza/astro-capo'
import { Schema } from 'astro-seo-schema'

import { pwaInfo } from 'virtual:pwa-info'
import { pwaAssetsHead } from 'virtual:pwa-assets/head'

import '@unocss/reset/tailwind.css'
import '@styles/global.css'

import { URL, TITLE, AUTHOR_NAME, AUTHOR_WEBSITE } from '@data/constants'

interface Options {
  title: string
  description: string
}

interface Props {
  options: Options
}

const { options } = Astro.props as Props
const { title, description } = options

function getLinkSizes(link: PWAAssetHeadLink) {
  if (link.sizes) return link.sizes
  if (link.rel === 'apple-touch-icon') return link.href.match(/(\d+x\d+)/)?.[1]
  return undefined
}
---

<!doctype html>
<html dir="ltr" lang="es">
  <Head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />

    <title>{title}</title>

    <link crossorigin href="//www.googletagmanager.com/" rel="preconnect" />
    <link crossorigin href="//www.google-analytics.com/" rel="preconnect" />

    <link as="image" fetchpriority="high" href="/logo.svg" rel="preload" type="image/svg+xml" />

    <meta content="index, follow" name="robots" />
    <meta content={description} name="description" />
    <meta content={`${AUTHOR_NAME} - ${AUTHOR_WEBSITE}`} name="author" />
    <link href={Astro.url.href} rel="canonical" />
    <meta content="IJH7DDHaPX1Us0he6rNkTPlC_9I5G5aktg3SKheBUNw" name="google-site-verification" />

    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
    { pwaAssetsHead.themeColor && <meta content={pwaAssetsHead.themeColor.content} name="theme-color" /> }
    { pwaAssetsHead.links.map((link) => (<link {...link} sizes={getLinkSizes(link)} />)) }
    <script src="@scripts/pwa.ts"></script>

    <meta content="black-translucent" name="apple-mobile-web-app-status-bar-style" />
    <meta content={TITLE} name="apple-mobile-web-app-title" />
    <meta content={TITLE} name="application-name" />
    <meta content="yes" name="apple-touch-fullscreen" />
    <meta content="yes" name="apple-mobile-web-app-capable" />
    <meta content="yes" name="mobile-web-app-capable" />

    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: TITLE,
        url: URL,
        applicationCategory: 'FinanceApplication',
        description,
        operatingSystem: 'All',
        browserRequirements: 'Requires JavaScript',
        creator: {
          '@type': 'Person',
          name: AUTHOR_NAME,
          url: AUTHOR_WEBSITE
        }
      }}
    />
  </Head>
  <body class:list={{ cover: Astro.url.pathname === '/' }}>
    <slot />
  </body>

  <script>
    import { initializeApp } from 'firebase/app'
    import { getAnalytics } from 'firebase/analytics'

    if (window.location.hostname === 'payoneer-calculator.web.app') {
      const firebaseConfig = {
        apiKey: 'AIzaSyAIt_klG3dCmYCPx00BLShcBj6xRHpQf2M',
        authDomain: 'payoneer-calculator.firebaseapp.com',
        projectId: 'payoneer-calculator',
        storageBucket: 'payoneer-calculator.appspot.com',
        messagingSenderId: '833757324098',
        appId: '1:833757324098:web:56d381a923cec448b41edb',
        measurementId: 'G-CMRJTB4RHV'
      }

      const app = initializeApp(firebaseConfig)
      getAnalytics(app)
    }
  </script>
</html>

<style>
  @view-transition {
    navigation: auto;
  }

  body {
    background: var(--highlight);
    color: var(--accent);
  }

  .cover {
    height: 100svh;
    overflow: hidden;
  }
</style>
