---
import { Head } from 'astro-capo'
import { Schema } from 'astro-seo-schema'

import { pwaInfo } from 'virtual:pwa-info'

import '@unocss/reset/tailwind.css'
import '@styles/global.css'

import SplashScreens from '@components/SplashScreens.astro'

interface Options {
  title: string
  description: string
}

interface Props {
  options: Options
}

const { options } = Astro.props as Props
const { title, description } = options
---

<!doctype html>
<html dir="ltr" lang="es">
  <Head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />

    <title>{title}</title>

    <link crossorigin href="//www.googletagmanager.com/" rel="preconnect" />
    <link crossorigin href="//www.google-analytics.com/" rel="preconnect" />

    <link as="image" fetchpriority="high" href="/img/logo.svg" rel="preload" type="image/svg+xml" />

    <meta content="index, follow" name="robots" />
    <meta content={description} name="description" />
    <meta content="Félix Icaza - https://felixicaza.com" name="author" />
    <link href={Astro.url.href} rel="canonical" />
    <meta content="IJH7DDHaPX1Us0he6rNkTPlC_9I5G5aktg3SKheBUNw" name="google-site-verification" />

    <link href="/favicons/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicons/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/favicons/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
    <link color="#ffece5" href="/favicons/safari-pinned-tab.svg" rel="mask-icon" />
    <meta content="#ffece5" name="msapplication-TileColor" />
    <meta content="#ffece5" name="theme-color" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="@scripts/pwa.ts"></script>

    <meta content="black-translucent" name="apple-mobile-web-app-status-bar-style" />
    <meta content="yes" name="apple-touch-fullscreen" />
    <meta content="Calculadora Payoneer" name="apple-mobile-web-app-title" />
    <meta content="Calculadora Payoneer" name="application-name" />
    <meta content="yes" name="apple-mobile-web-app-capable" />
    <meta content="yes" name="mobile-web-app-capable" />

    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'Payoneer Calculator',
        url: 'https://payoneer-calculator.web.app/',
        applicationCategory: 'FinanceApplication',
        description,
        operatingSystem: 'All',
        browserRequirements: 'Requires JavaScript',
        creator: {
          '@type': 'Person',
          name: 'Felix Icaza',
          url: 'https://felixicaza.com'
        }
      }}
    />

    <SplashScreens />
  </Head>
  <body class:list={{ cover: Astro.url.pathname === '/' }}>
    <slot />
  </body>

  <script>
    import { initializeApp } from 'firebase/app'
    import { getAnalytics } from 'firebase/analytics'

    if (window.location.hostname === 'payoneer-calculator.web.app') {
      const firebaseConfig = {
        apiKey: 'AIzaSyAIt_klG3dCmYCPx00BLShcBj6xRHpQf2M',
        authDomain: 'payoneer-calculator.firebaseapp.com',
        projectId: 'payoneer-calculator',
        storageBucket: 'payoneer-calculator.appspot.com',
        messagingSenderId: '833757324098',
        appId: '1:833757324098:web:56d381a923cec448b41edb',
        measurementId: 'G-CMRJTB4RHV'
      }

      const app = initializeApp(firebaseConfig)
      getAnalytics(app)
    }
  </script>
</html>

<style>
  @view-transition {
    navigation: auto;
  }

  body {
    background: var(--highlight);
    color: var(--accent);
  }

  .cover {
    height: 100svh;
    overflow: hidden;
  }
</style>
