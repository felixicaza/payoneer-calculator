---
import { AUTHOR_NAME } from '@data/constants';
---

<a class="author" href="https://felixicaza.com" target="_blank">
  Desarrollado por
  <img alt={AUTHOR_NAME} fetchpriority="high" src="/logo.svg" width="120" />
</a>

<p class="disclaimer">
  Esta es una herramienta independiente y no oficial. No está afiliada, patrocinada ni respaldada por Payoneer. Payoneer es una marca registrada de sus respectivos propietarios.
</p>

<style>
  .author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;

    img {
      aspect-ratio: 120 / 44;
    }
  }

  .disclaimer {
    font-size: 11px;
    margin-top: 2px;
    text-align: center;
  }
</style>
